# Local application settings. Do not commit real secrets.
APP_NAME=BATON API
APP_ENV=development
DATABASE_URL=sqlite:///./baton.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://baton-cbbw.onrender.com
# Ollama must be local to the backend host; remote/cloud endpoints are rejected.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120
